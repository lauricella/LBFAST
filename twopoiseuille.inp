&simulation
   nsteps=500
   stamp=100
   stamp2D=500
   stamp_term=50
   stepskip=1
   lreadisfluid=.false.   !set to true to read isfluid
   lreadinit=.false.  !set to true to read rho, phi, u, v and w
   lwriterestart=.false.
   lx=512
   ly=8
   lz=1024
   iprobe=256
   jprobe=4
   kprobe=512
   lprint=.true.
   lvtk=.false.
   lraw=.true.
   lasync=.false.
   lrestart=.false. !set to true to restart from a restart file
   lwriterestart=.false.
   pbc_x=0  !(0=false 1=true)
   pbc_y=1
   pbc_z=1 
   openbc=0
   nplanes=0 
&end
&fluid
   uwall=0.0e0
   fx=0.0e-6
   fy=0.0e-6
   fz=0.1e-6
   !rhoIN=0.0022 
   !rhoOUT=-0.0022 
   tau_diff=0.1e0  
   radius=40 !128
   width=4.0e0  
   sigma=0.00e0     
   wettab_r=90.0  !in degrees, from 30 to 130   
   !wettab_b=1.0e0
   llagrange=.true.  !Lagrange-multiplier correction of the total phi (used only if wettab_r /= 90)
   lagrange_every=100  !steps between two corrections    
   visc1= 0.05e0 !0.025e0
   !nnewt_K = 1.0e-3
   !nnewt_n = 0.5   ! alternatively 0.5 or 0.75
   !nnewt_tauy = 1.21e-5
   !nnewt_sor=1.0
   !nnewt_niter=10
   !tau_min=0.5001
   !tau_max=20.0
   visc2= 0.4e0 !0.025e0       
   !A_rep=-0.04  
   !q_th=0.125 
   !cosOppT=-0.8
   rho_r=0.5e0   
   rho_b=1.5e0  
   !npoint = 2
   !ndir = 2
&end 

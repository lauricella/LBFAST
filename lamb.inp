&simulation
   nsteps=20000
   stamp=100
   stamp2D=100
   stamp_term=10
   stepskip=1
   lreadisfluid=.false.   !metti true se leggi isfluid
   lreadinit=.false.  !metti true se leggi rho phi e u v w
   lwriterestart=.false.
   ! Refined cubic domain; every dimension is a multiple of TILE_DIM=8.
   lx=80
   ly=80
   lz=80
   iprobe=40
   jprobe=40
   kprobe=40
   lprint=.true.
   lvtk=.false.
   lraw=.false.
   lasync=.false.
   lrestart=.false. !metti true se riparti da restart
   lwriterestart=.false.
   pbc_x=1  !(0=false 1=true)
   pbc_y=1
   pbc_z=1
   openbc=0
   nplanes=0
&end
&fluid
   uwall=0.0e0
   fx=0.0e0
   fy=0.0e0
   fz=0.0e0
   !rhoIN=0.0022
   !rhoOUT=-0.0022
   tau_diff=0.1e0
   ! Twice the reference equivalent radius: semi-axes are 22, 22 and 30.
   radius=24.3962011464686e0
   ! Keep W=4 to reduce Cn=W/Re from 0.328 to 0.164.
   width=4.0e0
   center=40.0, 40.0, 40.0
   ! First high-surface-tension case in Table II
   sigma=2.27e-3
   wettab_r=90.0  !in degrees da 30 --> 130
   !wettab_b=1.0e0
   visc1=3.333e-3
   !nnewt_K = 1.0e-3
   !nnewt_n = 0.5   ! oppure 0.5 o 0.75
   !nnewt_tauy = 1.21e-5
   !nnewt_sor=1.0
   !nnewt_niter=10
   !tau_min=0.5001
   !tau_max=20.0
   visc2=3.333e-3
   !A_rep=-0.04
   !q_th=0.125
   !cosOppT=-0.8
   rho_r=4.0e0
   rho_b=1.0e0
   !npoint = 2
   !ndir = 2
&end

&simulation
   nsteps=20000
   stamp=100
   stamp2D=100
   stamp_term=10
   stepskip=1
   lreadisfluid=.false.   !metti true se leggi isfluid
   lreadinit=.false.  !metti true se leggi rho phi e u v w
   lwriterestart=.false.
   ! LBFAST requires each global dimension to be a multiple of TILE_DIM=8.
   ! Use 40^3, the nearest compatible domain to Saito's 41^3 lattice.
   lx=40
   ly=40
   lz=40
   iprobe=20
   jprobe=20
   kprobe=20
   lprint=.true.
   lvtk=.false.
   lraw=.true.
   lasync=.false.
   lrestart=.false. !metti true se riparti da restart
   lwriterestart=.false.
   pbc_x=1  !(0=false 1=true)
   pbc_y=1
   pbc_z=1
   openbc=0
   nplanes=0
&end
&fluid
   uwall=0.0e0
   fx=0.0e0
   fy=0.0e0
   fz=0.0e0
   !rhoIN=0.0022
   !rhoOUT=-0.0022
   tau_diff=0.1e0
   ! Equivalent radius Re=(11*11*15)^(1/3), used by Miller-Scriven
   radius=12.1981005732343e0
   ! Saito et al. use the same diffuse-interface width W=4
   width=4.0e0
   center=20.0, 20.0, 20.0
   ! First high-surface-tension case in Table II
   sigma=2.27e-3
   wettab_r=90.0  !in degrees da 30 --> 130
   !wettab_b=1.0e0
   visc1=3.333e-3
   !nnewt_K = 1.0e-3
   !nnewt_n = 0.5   ! oppure 0.5 o 0.75
   !nnewt_tauy = 1.21e-5
   !nnewt_sor=1.0
   !nnewt_niter=10
   !tau_min=0.5001
   !tau_max=20.0
   visc2=3.333e-3
   !A_rep=-0.04
   !q_th=0.125
   !cosOppT=-0.8
   rho_r=4.0e0
   rho_b=1.0e0
   !npoint = 2
   !ndir = 2
&end

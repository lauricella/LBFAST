  "configurePresets": [
    {
      "name": "default",
      "displayName": "Macros from defines.h, MPI, GPUCC=80",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GPUCC": "80",
        "LBFAST_MPI": "ON",
        "LBFAST_NVML": "OFF",
        "LBFAST_USE_DEFINES_H": "ON"
      }
    },
